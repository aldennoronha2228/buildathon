# Port the API + static server listens on (default 8080)
PORT=8080

# ---------------- Sarvam AI (speech-to-text + LLM term extraction) ----------------
# https://dashboard.sarvam.ai — create an API key (subscription key).
# Leave SARVAM_API_KEY empty to run the app in demo mode (scripted transcripts,
# regex amount parsing). Keys are used server-side only, never sent to the browser.
SARVAM_API_KEY=
SARVAM_BASE=https://api.sarvam.ai
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_LLM_MODEL=sarvam-m

# ---------------- Cashfree Payment Gateway ----------------
# https://merchant.cashfree.com — Credentials → App ID + Secret Key.
# Leave both empty to use the simulated gateway (mock intents + verify button).
# With keys set, each milestone creates a real Cashfree Payment Link and
# settlement arrives via webhook / status polling.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox                     # sandbox | production
CASHFREE_API_VERSION=2023-08-01
CASHFREE_WEBHOOK_SECRET=                 # Webhooks → Secret (for signature verification)

# Public base URL of this deployment (used for Cashfree return/notify URLs).
# Falls back to the incoming request host when unset.
PUBLIC_BASE_URL=
